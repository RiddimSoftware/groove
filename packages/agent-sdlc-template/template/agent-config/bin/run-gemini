#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
PROFILE_KEY=""
CHECK_PROFILE=false
DRY_RUN=false
FORCE=false
AUTO_ROTATE="${GEMINI_AUTO_ROTATE:-false}"
MAX_FALLBACK_ATTEMPTS="${GEMINI_MAX_FALLBACK_ATTEMPTS:-2}"
FALLBACK_BACKOFF_SECONDS="${GEMINI_FALLBACK_BACKOFF_SECONDS:-1}"
MIGRATE_FROM=""
GEMINI_ARGS=()
REQUIRED_PROFILE_FILES=(oauth_creds.json google_accounts.json settings.json)

usage() {
  cat <<'EOF'
Usage:
  run-gemini [--profile <key>] [--check] [--auto-rotate|--no-auto-rotate] [gemini-args...]
  run-gemini --profile <key> --migrate-from <path> [--dry-run] [--force]
  run-gemini -h|--help

Launch Gemini CLI with profile-aware home directory isolation.

Profile selection (first match wins):
  --profile <key>           Select a profile by registry key
  GEMINI_PROFILE=<key>      Select a profile via environment variable

Profile root directory:
  GEMINI_PROFILE_ROOT=<path>  Parent directory for profile home directories
  Default: ${XDG_STATE_HOME:-$HOME/.local/state}/gemini/profiles

Registry file (enables key validation and profile listing):
  GEMINI_PROFILE_REGISTRY=<path>  Override registry JSON file path
  Default: $GEMINI_PROFILE_ROOT/registry.json

Validation:
  --check                   Validate oauth_creds.json, google_accounts.json,
                            and settings.json before launching Gemini.

Quota-aware fallback:
  --auto-rotate             Retry with additional active registry profiles when
                            Gemini exits with quota/auth limit signatures.
  --no-auto-rotate          Disable fallback for this invocation, even when
                            GEMINI_AUTO_ROTATE is set.
  --max-fallback-attempts <n>
                            Maximum additional profiles to try after the first.
                            Default: GEMINI_MAX_FALLBACK_ATTEMPTS or 2.
  --fallback-backoff-seconds <n>
                            Base delay before each fallback retry. A small
                            random jitter is added. Default:
                            GEMINI_FALLBACK_BACKOFF_SECONDS or 1.

Migration:
  --migrate-from <path>     Copy an existing Gemini state directory into the
                            selected profile. <path> may be ~/.gemini or a
                            GEMINI_CLI_HOME root containing .gemini/.
  --dry-run                 Report migration actions without writing files.
  --force                   Allow replacing an existing target .gemini state.

Fallback behavior:
  When no profile is specified and a registry exists, a random active profile
  is selected automatically (load-balancing across accounts). If no registry
  is present, gemini uses its default home directory (~/.gemini). Quota-aware
  retry across other active registry profiles is enabled only with
  --auto-rotate or GEMINI_AUTO_ROTATE=true.

Examples:
  run-gemini                               # interactive, default home
  run-gemini --profile primary --check     # validate, then launch
  run-gemini --profile primary -p "hello"  # non-interactive single prompt
  run-gemini --auto-rotate -p "hello"      # fallback across active profiles
  run-gemini --profile primary --migrate-from ~/.gemini --dry-run
  run-gemini --profile primary --migrate-from ~/.gemini --force

See docs/gemini-profile-registry.md for the registry file format.
EOF
}

die() {
  printf '%s: error: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

warn() {
  printf '%s: warning: %s\n' "$SCRIPT_NAME" "$*" >&2
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

normalize_bool() {
  local raw="$1"
  local value
  value="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"

  case "$value" in
    1|true|yes|on)
      printf 'true\n'
      ;;
    0|false|no|off)
      printf 'false\n'
      ;;
    *)
      die "invalid boolean value: $raw"
      ;;
  esac
}

is_nonnegative_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

join_by_comma() {
  local IFS=,
  printf '%s' "$*"
}

is_dir_nonempty() {
  [[ -d "$1" ]] && find "$1" -mindepth 1 -maxdepth 1 -print -quit | grep -q .
}

canonical_existing_path() {
  local path="$1"
  if [[ -d "$path" ]]; then
    (cd -P "$path" && pwd)
  else
    local parent
    parent="$(dirname "$path")"
    local base
    base="$(basename "$path")"
    (cd -P "$parent" && printf '%s/%s\n' "$PWD" "$base")
  fi
}

normalize_absolute_path() {
  local path="$1"
  if [[ "$path" != /* ]]; then
    path="$PWD/$path"
  fi

  local IFS='/'
  local -a parts=()
  local -a normalized=()
  read -r -a parts <<< "$path"

  local part
  for part in "${parts[@]}"; do
    case "$part" in
      ""|.)
        ;;
      ..)
        if [[ ${#normalized[@]} -gt 0 ]]; then
          unset "normalized[$((${#normalized[@]} - 1))]"
        fi
        ;;
      *)
        normalized+=("$part")
        ;;
    esac
  done

  if [[ ${#normalized[@]} -eq 0 ]]; then
    printf '/\n'
  else
    local joined
    joined="$(IFS=/; printf '%s' "${normalized[*]}")"
    printf '/%s\n' "$joined"
  fi
}

canonical_path_allow_missing() {
  local path
  path="$(normalize_absolute_path "$1")"

  local probe="$path"
  local missing_suffix=""
  while [[ ! -e "$probe" && "$probe" != "/" ]]; do
    missing_suffix="/$(basename "$probe")$missing_suffix"
    probe="$(dirname "$probe")"
  done

  local resolved
  resolved="$(canonical_existing_path "$probe")"

  if [[ -z "$missing_suffix" ]]; then
    printf '%s\n' "$resolved"
    return
  fi

  if [[ "$resolved" == "/" ]]; then
    printf '%s\n' "$missing_suffix"
  else
    printf '%s%s\n' "$resolved" "$missing_suffix"
  fi
}

path_is_under() {
  local child="$1"
  local parent="$2"
  [[ "$child" == "$parent" || "$child" == "$parent"/* ]]
}

resolve_source_state_dir() {
  local source="$1"
  [[ -e "$source" ]] || die "migration source does not exist: $source"
  [[ -d "$source" ]] || die "migration source must be a directory: $source"

  if [[ -f "$source/oauth_creds.json" || -f "$source/google_accounts.json" || -f "$source/settings.json" ]]; then
    canonical_existing_path "$source"
    return
  fi

  if [[ -d "$source/.gemini" ]]; then
    canonical_existing_path "$source/.gemini"
    return
  fi

  die "migration source must be ~/.gemini-style state or a GEMINI_CLI_HOME root containing .gemini/"
}

validate_required_files() {
  local state_dir="$1"
  local missing=()

  for required_file in "${REQUIRED_PROFILE_FILES[@]}"; do
    if [[ ! -f "$state_dir/$required_file" ]]; then
      missing+=("$required_file")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    printf '%s: profile state is incomplete: %s\n' "$SCRIPT_NAME" "$state_dir" >&2
    printf 'Missing required files:\n' >&2
    for missing_file in "${missing[@]}"; do
      printf '  - %s\n' "$missing_file" >&2
    done
    return 1
  fi
}

ensure_secure_target() {
  local profile_root="$1"
  local profile_home="$2"

  local canonical_repo
  canonical_repo="$(canonical_existing_path "$REPO_ROOT")"

  local canonical_profile_root
  canonical_profile_root="$(canonical_path_allow_missing "$profile_root")"

  if path_is_under "$canonical_profile_root" "$canonical_repo"; then
    die "refusing to migrate credentials under repository path: $canonical_profile_root"
  fi

  local canonical_profile_home
  canonical_profile_home="$(canonical_path_allow_missing "$profile_home")"

  if path_is_under "$canonical_profile_home" "$canonical_repo"; then
    die "refusing to migrate credentials under repository path: $canonical_profile_home"
  fi
}

migrate_profile_state() {
  local source_state_dir="$1"
  local profile_root="$2"
  local profile_home="$3"
  local target_state_dir="$profile_home/.gemini"

  validate_required_files "$source_state_dir" || die "migration source is missing required auth state"
  ensure_secure_target "$profile_root" "$profile_home"

  local canonical_source
  canonical_source="$(canonical_existing_path "$source_state_dir")"
  local canonical_target
  canonical_target="$(canonical_path_allow_missing "$target_state_dir")"

  if [[ "$canonical_source" == "$canonical_target" ]]; then
    die "migration source and target are the same directory: $canonical_source"
  fi

  printf '%s: migration plan\n' "$SCRIPT_NAME"
  printf '  source: %s\n' "$canonical_source"
  printf '  target: %s\n' "$target_state_dir"
  printf '  required files: %s\n' "${REQUIRED_PROFILE_FILES[*]}"

  if [[ "$DRY_RUN" == true ]]; then
    if is_dir_nonempty "$target_state_dir"; then
      printf '  target status: exists and would require --force to replace\n'
    else
      printf '  target status: would be created\n'
    fi
    printf '  action: dry run only; no credential files copied\n'
    return 0
  fi

  if is_dir_nonempty "$target_state_dir" && [[ "$FORCE" != true ]]; then
    warn "target profile state already exists and may contain active credentials: $target_state_dir"
    die "refusing to overwrite without --force"
  fi

  if is_dir_nonempty "$target_state_dir" && [[ "$FORCE" == true ]]; then
    warn "overwriting existing Gemini profile state at $target_state_dir"
    rm -rf "$target_state_dir"
  fi

  mkdir -p "$profile_home"
  chmod 700 "$profile_home" 2>/dev/null || true
  mkdir -p "$target_state_dir"
  chmod 700 "$target_state_dir" 2>/dev/null || true
  cp -pR "$canonical_source/." "$target_state_dir/"

  chmod 600 "$target_state_dir/oauth_creds.json" 2>/dev/null || true
  chmod 644 "$target_state_dir/google_accounts.json" "$target_state_dir/settings.json" 2>/dev/null || true
  printf '%s: migration complete: %s\n' "$SCRIPT_NAME" "$target_state_dir"
}

registry_active_profile_keys() {
  jq -r '
    .profiles
    | to_entries
    | sort_by(.value.rotationOrder, .key)[]
    | select(.value.licenseActive == true and .value.status == "active")
    | .key
  ' "$REGISTRY_FILE"
}

registry_profile_local_dir() {
  local key="$1"
  jq -r --arg key "$key" '.profiles[$key].localProfileDirectory // empty' "$REGISTRY_FILE"
}

build_profile_chain() {
  local selected_key="$1"
  local max_additional="$2"
  local active_keys_text="$3"
  local key
  local remaining_slots=$max_additional

  PROFILE_CHAIN=("$selected_key")

  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    [[ "$key" != "$selected_key" ]] || continue
    [[ "$remaining_slots" -gt 0 ]] || break
    PROFILE_CHAIN+=("$key")
    remaining_slots=$((remaining_slots - 1))
  done <<< "$active_keys_text"
}

fallback_reason_from_output() {
  local output_file="$1"

  if grep -Eiq '(^|[^0-9])429([^0-9]|$)|RATE_LIMIT|RESOURCE_EXHAUSTED|QUOTA_EXCEEDED|QuotaFailure|quota|rate limit|rateLimitExceeded|userRateLimitExceeded|dailyLimitExceeded|too many requests|limit exceeded|exceeded[^[:cntrl:]]*(limit|quota)|RequestsPerMinute|TokensPerMinute' "$output_file"; then
    printf 'quota\n'
    return 0
  fi

  if grep -Eiq '(^|[^0-9])40[13]([^0-9]|$)|UNAUTHENTICATED|PERMISSION_DENIED|invalid[_ -]?grant|invalid[_ -]?credential|credential[^[:cntrl:]]*expired|expired[^[:cntrl:]]*credential|login required|not authenticated|reauth|re-auth|OAuth' "$output_file"; then
    printf 'auth\n'
    return 0
  fi

  printf 'non_retryable\n'
  return 1
}

fallback_sleep() {
  local base_seconds="$1"
  [[ "$base_seconds" -gt 0 ]] || return 0

  local jitter_ms
  jitter_ms=$((RANDOM % 1000))
  sleep "$(printf '%s.%03d' "$base_seconds" "$jitter_ms")"
}

run_gemini_with_fallback() {
  local chain
  chain="$(join_by_comma "${PROFILE_CHAIN[@]}")"

  printf '%s: rotation_chain=%s max_fallback_attempts=%s backoff_seconds=%s\n' \
    "$SCRIPT_NAME" "$chain" "$MAX_FALLBACK_ATTEMPTS" "$FALLBACK_BACKOFF_SECONDS" >&2

  local attempt=0
  local profile_key
  local last_status=1
  local last_reason="not_run"

  for profile_key in "${PROFILE_CHAIN[@]}"; do
    attempt=$((attempt + 1))

    local local_profile_dir
    local_profile_dir="$(registry_profile_local_dir "$profile_key")"
    if [[ -z "$local_profile_dir" ]]; then
      local_profile_dir="$profile_key"
    fi
    [[ "$local_profile_dir" != /* && "$local_profile_dir" != *..* ]] || die "profile localProfileDirectory must be relative and must not contain ..: $local_profile_dir"

    local gemini_home="$PROFILE_ROOT/$local_profile_dir"
    local stdout_file stderr_file combined_file
    stdout_file="$(mktemp "${TMPDIR:-/tmp}/run-gemini-stdout.XXXXXX")"
    stderr_file="$(mktemp "${TMPDIR:-/tmp}/run-gemini-stderr.XXXXXX")"
    combined_file="$(mktemp "${TMPDIR:-/tmp}/run-gemini-output.XXXXXX")"

    set +e
    GEMINI_CLI_HOME="$gemini_home" gemini "${GEMINI_ARGS[@]+"${GEMINI_ARGS[@]}"}" >"$stdout_file" 2>"$stderr_file"
    last_status=$?
    set -e

    cat "$stdout_file"
    cat "$stderr_file" >&2
    cat "$stdout_file" "$stderr_file" >"$combined_file"

    if [[ "$last_status" -eq 0 ]]; then
      printf '%s: attempt=%s profile=%s status=succeeded reason=none exit_code=0\n' \
        "$SCRIPT_NAME" "$attempt" "$profile_key" >&2
      rm -f "$stdout_file" "$stderr_file" "$combined_file"
      return 0
    fi

    last_reason="$(fallback_reason_from_output "$combined_file" || true)"
    if [[ "$last_reason" == "non_retryable" ]]; then
      printf '%s: attempt=%s profile=%s status=failed reason=non_retryable exit_code=%s fallback=false\n' \
        "$SCRIPT_NAME" "$attempt" "$profile_key" "$last_status" >&2
      rm -f "$stdout_file" "$stderr_file" "$combined_file"
      return "$last_status"
    fi

    if [[ "$attempt" -ge "${#PROFILE_CHAIN[@]}" ]]; then
      printf '%s: attempt=%s profile=%s status=failed reason=%s exit_code=%s fallback=false\n' \
        "$SCRIPT_NAME" "$attempt" "$profile_key" "$last_reason" "$last_status" >&2
      rm -f "$stdout_file" "$stderr_file" "$combined_file"
      break
    fi

    printf '%s: attempt=%s profile=%s status=failed reason=%s exit_code=%s fallback=true\n' \
      "$SCRIPT_NAME" "$attempt" "$profile_key" "$last_reason" "$last_status" >&2
    rm -f "$stdout_file" "$stderr_file" "$combined_file"
    fallback_sleep "$FALLBACK_BACKOFF_SECONDS"
  done

  printf '%s: error: all attempted Gemini profiles failed with quota/auth fallback signatures; chain=%s last_reason=%s\n' \
    "$SCRIPT_NAME" "$chain" "$last_reason" >&2
  printf '%s: error: rerun with --profile <key> --no-auto-rotate to inspect a single profile, or update the registry/profile auth state.\n' \
    "$SCRIPT_NAME" >&2
  return "$last_status"
}

# Parse run-gemini's own flags; collect remaining args for gemini.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || die "--profile requires an argument"
      PROFILE_KEY="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE_KEY="${1#--profile=}"
      shift
      ;;
    --check)
      CHECK_PROFILE=true
      shift
      ;;
    --auto-rotate)
      AUTO_ROTATE=true
      shift
      ;;
    --no-auto-rotate)
      AUTO_ROTATE=false
      shift
      ;;
    --max-fallback-attempts)
      [[ $# -ge 2 ]] || die "--max-fallback-attempts requires an argument"
      MAX_FALLBACK_ATTEMPTS="$2"
      shift 2
      ;;
    --max-fallback-attempts=*)
      MAX_FALLBACK_ATTEMPTS="${1#--max-fallback-attempts=}"
      shift
      ;;
    --fallback-backoff-seconds)
      [[ $# -ge 2 ]] || die "--fallback-backoff-seconds requires an argument"
      FALLBACK_BACKOFF_SECONDS="$2"
      shift 2
      ;;
    --fallback-backoff-seconds=*)
      FALLBACK_BACKOFF_SECONDS="${1#--fallback-backoff-seconds=}"
      shift
      ;;
    --migrate-from)
      [[ $# -ge 2 ]] || die "--migrate-from requires an argument"
      MIGRATE_FROM="$2"
      shift 2
      ;;
    --migrate-from=*)
      MIGRATE_FROM="${1#--migrate-from=}"
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --force)
      FORCE=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      GEMINI_ARGS+=("$@")
      break
      ;;
    *)
      GEMINI_ARGS+=("$1")
      shift
      ;;
  esac
done

AUTO_ROTATE="$(normalize_bool "$AUTO_ROTATE")"
is_nonnegative_integer "$MAX_FALLBACK_ATTEMPTS" || die "--max-fallback-attempts must be a non-negative integer"
is_nonnegative_integer "$FALLBACK_BACKOFF_SECONDS" || die "--fallback-backoff-seconds must be a non-negative integer"

if [[ -z "$PROFILE_KEY" && -n "${GEMINI_PROFILE:-}" ]]; then
  PROFILE_KEY="${GEMINI_PROFILE}"
fi

PROFILE_ROOT="${GEMINI_PROFILE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/gemini/profiles}"
REGISTRY_FILE="${GEMINI_PROFILE_REGISTRY:-$PROFILE_ROOT/registry.json}"

if [[ -z "$PROFILE_KEY" ]]; then
  [[ -z "$MIGRATE_FROM" ]] || die "--migrate-from requires --profile"
  [[ "$CHECK_PROFILE" == false ]] || die "--check requires --profile"
  [[ "$DRY_RUN" == false ]] || die "--dry-run requires --migrate-from"
  [[ "$FORCE" == false ]] || die "--force requires --migrate-from"

  # Auto-select a random active profile from the registry when available.
  if [[ -f "$REGISTRY_FILE" ]] && command -v jq >/dev/null 2>&1; then
    _ACTIVE_KEYS="$(registry_active_profile_keys 2>/dev/null || true)"
    if [[ -n "$_ACTIVE_KEYS" ]]; then
      _KEY_COUNT="$(printf '%s\n' "$_ACTIVE_KEYS" | wc -l | tr -d ' ')"
      RANDOM=$(( $(od -An -N2 -tu2 /dev/urandom | tr -d ' ') ^ $$ ))
      _RANDOM_INDEX=$(( (RANDOM % _KEY_COUNT) + 1 ))
      PROFILE_KEY="$(printf '%s\n' "$_ACTIVE_KEYS" | sed -n "${_RANDOM_INDEX}p")"
      printf '%s: auto-selected profile: %s\n' "$SCRIPT_NAME" "$PROFILE_KEY" >&2
    fi
  fi
  unset _ACTIVE_KEYS _KEY_COUNT _RANDOM_INDEX

  if [[ -z "$PROFILE_KEY" ]]; then
    if [[ "$AUTO_ROTATE" == true ]]; then
      warn "auto-rotation requested but registry file was not found or has no active profiles: $REGISTRY_FILE"
    fi
    require_cmd gemini
    exec gemini "${GEMINI_ARGS[@]+"${GEMINI_ARGS[@]}"}"
  fi
fi

[[ "$PROFILE_KEY" != */* && "$PROFILE_KEY" != *..* ]] || die "invalid profile key (must not contain / or ..): $PROFILE_KEY"
[[ "$DRY_RUN" == false || -n "$MIGRATE_FROM" ]] || die "--dry-run requires --migrate-from"
[[ "$FORCE" == false || -n "$MIGRATE_FROM" ]] || die "--force requires --migrate-from"

LOCAL_PROFILE_DIR="$PROFILE_KEY"
ACTIVE_PROFILE_KEYS_TEXT=""

if [[ -f "$REGISTRY_FILE" ]]; then
  command -v jq >/dev/null 2>&1 || die "jq is required for profile validation (registry: $REGISTRY_FILE)"
  ACTIVE_PROFILE_KEYS_TEXT="$(registry_active_profile_keys)"

  PROFILE_JSON="$(jq -r --arg key "$PROFILE_KEY" '.profiles[$key] // empty' "$REGISTRY_FILE" 2>/dev/null || true)"
  if [[ -z "$PROFILE_JSON" ]]; then
    KNOWN_KEYS="$(jq -r '.profiles | keys[]' "$REGISTRY_FILE" 2>/dev/null | sort | sed 's/^/  /' || echo '  (could not read registry)')"
    printf '%s: unknown profile: %s\n' "$SCRIPT_NAME" "$PROFILE_KEY" >&2
    printf 'Known profiles in %s:\n%s\n' "$REGISTRY_FILE" "$KNOWN_KEYS" >&2
    exit 1
  fi

  LICENSE_ACTIVE="$(jq -r --arg key "$PROFILE_KEY" '.profiles[$key].licenseActive' "$REGISTRY_FILE")"
  PROFILE_STATUS="$(jq -r --arg key "$PROFILE_KEY" '.profiles[$key].status' "$REGISTRY_FILE")"
  if [[ "$LICENSE_ACTIVE" != "true" || "$PROFILE_STATUS" != "active" ]]; then
    printf '%s: profile %s is not eligible (licenseActive=%s status=%s)\n' \
      "$SCRIPT_NAME" "$PROFILE_KEY" "$LICENSE_ACTIVE" "$PROFILE_STATUS" >&2
    exit 1
  fi

  REG_DIR="$(registry_profile_local_dir "$PROFILE_KEY" 2>/dev/null || true)"
  if [[ -n "$REG_DIR" ]]; then
    LOCAL_PROFILE_DIR="$REG_DIR"
  fi
elif [[ "$AUTO_ROTATE" == true ]]; then
  warn "auto-rotation requested but registry file was not found: $REGISTRY_FILE"
fi

[[ "$LOCAL_PROFILE_DIR" != /* && "$LOCAL_PROFILE_DIR" != *..* ]] || die "profile localProfileDirectory must be relative and must not contain ..: $LOCAL_PROFILE_DIR"

GEMINI_HOME="$PROFILE_ROOT/$LOCAL_PROFILE_DIR"
PROFILE_STATE_DIR="$GEMINI_HOME/.gemini"

if [[ -n "$MIGRATE_FROM" ]]; then
  SOURCE_STATE_DIR="$(resolve_source_state_dir "$MIGRATE_FROM")"
  migrate_profile_state "$SOURCE_STATE_DIR" "$PROFILE_ROOT" "$GEMINI_HOME"
  exit 0
fi

if [[ "$CHECK_PROFILE" == true ]]; then
  validate_required_files "$PROFILE_STATE_DIR" || exit 1
elif [[ ! -d "$GEMINI_HOME" ]]; then
  warn "profile directory not found: $GEMINI_HOME"
  printf '  To set up this profile, run:\n' >&2
  printf '    GEMINI_CLI_HOME=%s gemini\n' "$GEMINI_HOME" >&2
  printf '  then complete the OAuth flow in your browser.\n' >&2
fi

require_cmd gemini
if [[ "$AUTO_ROTATE" == true && -f "$REGISTRY_FILE" && -n "$ACTIVE_PROFILE_KEYS_TEXT" ]]; then
  build_profile_chain "$PROFILE_KEY" "$MAX_FALLBACK_ATTEMPTS" "$ACTIVE_PROFILE_KEYS_TEXT"
  run_gemini_with_fallback
  exit $?
fi

export GEMINI_CLI_HOME="$GEMINI_HOME"
exec gemini "${GEMINI_ARGS[@]+"${GEMINI_ARGS[@]}"}"
