#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
DRY_RUN=0
NO_LAUNCH=0

usage() {
  cat <<'EOF'
Usage:
  agent-worktree [--dry-run] [--no-launch] <repo-root> <slug> -- <agent-command> [args...]
  agent-worktree [--dry-run] [--no-launch] <repo-root> <slug>

Creates or reuses a managed git worktree for manual Claude/Codex/Gemini work.

This command creates a managed worktree from a just-fetched origin/main
without modifying the root checkout. The root checkout's branch, staged changes,
and untracked files are preserved.

Examples:
  agent-worktree /YOUR/WORKSPACE/DIR/bap bap-copy-fix -- codex
  agent-worktree /YOUR/WORKSPACE/DIR/riddim-website web-header-copy -- claude
  agent-worktree --no-launch /YOUR/WORKSPACE/DIR/autopilot root-repair-test -- gemini
  agent-worktree --dry-run /YOUR/WORKSPACE/DIR/agent-config del-286-smoke -- codex

Options:
  --dry-run    Print the exact reset/clean/worktree/launch commands without changing anything.
  --no-launch  Prepare the root + worktree but do not launch the agent command.
  -h, --help   Show this help text.
EOF
}

die() {
  echo "$SCRIPT_NAME: error: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

shell_join() {
  local first=1
  local arg
  for arg in "$@"; do
    if [[ $first -eq 0 ]]; then
      printf ' '
    fi
    printf '%q' "$arg"
    first=0
  done
}

log_command() {
  local command_string
  command_string="$(shell_join "$@")"
  if [[ $DRY_RUN -eq 1 ]]; then
    printf 'dry-run: %s\n' "$command_string"
  else
    printf 'run: %s\n' "$command_string"
    "$@"
  fi
}

sanitize_slug() {
  local value="$1"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  value="$(printf '%s' "$value" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g')"
  [[ -n "$value" ]] || die "slug must contain at least one letter or number"
  printf '%s' "$value"
}

branch_name_for_slug() {
  local normalized_slug="$1"
  if [[ "$normalized_slug" =~ ^[a-z]+-[0-9]+($|-) ]]; then
    printf 'claude/%s' "$normalized_slug"
  else
    printf 'claude/manual-%s' "$normalized_slug"
  fi
}

worktree_contains_path() {
  local repo_root="$1"
  local candidate="$2"
  git -C "$repo_root" worktree list --porcelain | awk '/^worktree / { sub(/^worktree /, "", $0); print }' | grep -Fx "$candidate" >/dev/null 2>&1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --no-launch)
      NO_LAUNCH=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -ge 2 ]] || {
  usage >&2
  exit 1
}

require_cmd git

INPUT_PATH="$1"
RAW_SLUG="$2"
shift 2
if [[ $# -gt 0 && "$1" == "--" ]]; then
  shift
fi
AGENT_COMMAND=("$@")

if [[ ${#AGENT_COMMAND[@]} -eq 0 && $NO_LAUNCH -eq 0 && $DRY_RUN -eq 0 ]]; then
  die "agent command is required unless --no-launch or --dry-run is used"
fi

[[ -d "$INPUT_PATH" ]] || die "path does not exist: $INPUT_PATH"
REPO_ROOT="$(cd -P "$INPUT_PATH" && pwd)"

if ! git -C "$REPO_ROOT" rev-parse --show-toplevel >/dev/null 2>&1; then
  die "path is not a git repository: $REPO_ROOT"
fi
REPO_ROOT="$(git -C "$REPO_ROOT" rev-parse --show-toplevel)"
ORIGIN_URL="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
[[ -n "$ORIGIN_URL" ]] || die "repository has no origin remote: $REPO_ROOT"

NORMALIZED_SLUG="$(sanitize_slug "$RAW_SLUG")"
BRANCH_NAME="$(branch_name_for_slug "$NORMALIZED_SLUG")"
REPO_NAME="$(basename "$REPO_ROOT")"
REPO_PARENT="$(cd -P "$(dirname "$REPO_ROOT")" && pwd)"
WORKTREE_BASE="$REPO_PARENT/${REPO_NAME}-worktrees"
WORKTREE_LEAF="${BRANCH_NAME//\//--}"
WORKTREE_PATH="$WORKTREE_BASE/$WORKTREE_LEAF"

ROOT_FETCH_CMD=(git -C "$REPO_ROOT" fetch origin main)
WORKTREE_ADD_CMD=(git -C "$REPO_ROOT" worktree add -B "$BRANCH_NAME" "$WORKTREE_PATH" origin/main)

WORKTREE_EXISTS=0
if [[ -e "$WORKTREE_PATH" ]]; then
  if worktree_contains_path "$REPO_ROOT" "$WORKTREE_PATH"; then
    WORKTREE_EXISTS=1
  else
    die "target worktree path already exists and is not a registered git worktree: $WORKTREE_PATH"
  fi
fi

printf 'Root repo: %s\n' "$REPO_ROOT"
printf 'Origin: %s\n' "$ORIGIN_URL"
printf 'Branch: %s\n' "$BRANCH_NAME"
printf 'Worktree path: %s\n' "$WORKTREE_PATH"
printf 'Dry run: %s\n' "$([[ $DRY_RUN -eq 1 ]] && printf true || printf false)"
printf 'Launch: %s\n' "$([[ $NO_LAUNCH -eq 1 || ${#AGENT_COMMAND[@]} -eq 0 ]] && printf false || printf true)"

if [[ ${#AGENT_COMMAND[@]} -gt 0 ]]; then
  printf 'Agent command: %s\n' "$(shell_join "${AGENT_COMMAND[@]}")"
else
  printf 'Agent command: (none)\n'
fi

log_command "${ROOT_FETCH_CMD[@]}"

if [[ $WORKTREE_EXISTS -eq 1 ]]; then
  printf 'reuse: %s\n' "$WORKTREE_PATH"
else
  if [[ $DRY_RUN -eq 0 ]]; then
    mkdir -p "$WORKTREE_BASE"
  fi
  log_command "${WORKTREE_ADD_CMD[@]}"
fi

if [[ ${#AGENT_COMMAND[@]} -eq 0 || $NO_LAUNCH -eq 1 ]]; then
  if [[ ${#AGENT_COMMAND[@]} -gt 0 ]]; then
    printf 'no-launch command: cd %q && exec %s\n' "$WORKTREE_PATH" "$(shell_join "${AGENT_COMMAND[@]}")"
  else
    printf 'no-launch command: (no agent command supplied)\n'
  fi
  exit 0
fi

if [[ $DRY_RUN -eq 1 ]]; then
  printf 'launch command: cd %q && exec %s\n' "$WORKTREE_PATH" "$(shell_join "${AGENT_COMMAND[@]}")"
  exit 0
fi

printf 'launch: cd %q && exec %s\n' "$WORKTREE_PATH" "$(shell_join "${AGENT_COMMAND[@]}")"
cd "$WORKTREE_PATH"
exec "${AGENT_COMMAND[@]}"
