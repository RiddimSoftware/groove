#!/bin/bash
# workflow-sync-push — direct-to-main helper for generated workflow shim syncs.
#
# Safety model:
#   - Opt-in only via RIDDIM_WORKFLOW_SYNC_PUSH=1
#   - Refuses to push unless every changed path is under .github/workflows/
#   - Uses a selected-repo GitHub App installation token minted from AWS Secrets
#   - Pushes the already-committed HEAD to the target branch; it does not commit

set -euo pipefail

KEY_FILE=""
ASKPASS_FILE=""

die() {
  echo "agent-config/bin/workflow-sync-push: error: $*" >&2
  exit 1
}

cleanup() {
  if [[ -n "${KEY_FILE:-}" ]]; then
    rm -f "$KEY_FILE"
  fi
  if [[ -n "${ASKPASS_FILE:-}" ]]; then
    rm -f "$ASKPASS_FILE"
  fi
  return 0
}
trap cleanup EXIT

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

aws_get_secret() {
  local parameter_name="$1"
  local value
  # AWS SSM Parameter Store requires hierarchical names to start with /.
  # Callers may still pass the SM-style "agent-loop/..." form; normalize.
  case "$parameter_name" in
    /*) ;;
    *) parameter_name="/$parameter_name" ;;
  esac
  value=$(aws ssm get-parameter \
    --name "$parameter_name" \
    --with-decryption \
    --region "${AWS_REGION}" \
    --query 'Parameter.Value' \
    --output text 2>/dev/null) || die "failed to fetch parameter: $parameter_name (check AWS_PROFILE=${AWS_PROFILE} and parameter existence)"
  printf '%s' "$value"
}

usage() {
  cat <<'EOF'
Usage:
  RIDDIM_WORKFLOW_SYNC_PUSH=1 workflow-sync-push status [options]
  RIDDIM_WORKFLOW_SYNC_PUSH=1 workflow-sync-push push   [options]

Options:
  --repo OWNER/REPO     Target GitHub repository. Defaults to origin remote.
  --branch NAME         Target branch to push to. Default: main
  --base REF            Base ref used for changed-file validation. Default: origin/main
  --allow-prefix PATH   Allowed changed-file prefix. Default: .github/workflows/
  --dry-run             Validate auth + changed paths but skip git push.

Environment defaults:
  AWS_PROFILE=your-aws-profile
  AWS_REGION=us-east-1
  RIDDIM_WORKFLOW_SYNC_APP_ID_SECRET=agent-loop/workflow-sync-app-id
  RIDDIM_WORKFLOW_SYNC_PRIVATE_KEY_SECRET=agent-loop/workflow-sync-private-key
  RIDDIM_WORKFLOW_SYNC_LOGIN=riddim-release[bot]
EOF
}

[[ "${RIDDIM_WORKFLOW_SYNC_PUSH:-}" == "1" ]] || die "RIDDIM_WORKFLOW_SYNC_PUSH=1 is required"

MODE="${1:-}"
case "$MODE" in
  status|push) shift ;;
  -h|--help|"") usage; exit 0 ;;
  *) die "unknown mode: $MODE" ;;
esac

TARGET_REPO=""
TARGET_BRANCH="main"
BASE_REF="origin/main"
ALLOW_PREFIX=".github/workflows/"
DRY_RUN="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      TARGET_REPO="${2:-}"
      shift 2
      ;;
    --branch)
      TARGET_BRANCH="${2:-}"
      shift 2
      ;;
    --base)
      BASE_REF="${2:-}"
      shift 2
      ;;
    --allow-prefix)
      ALLOW_PREFIX="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

AWS_PROFILE="${AWS_PROFILE:-your-aws-profile}"
AWS_REGION="${AWS_REGION:-us-east-1}"
APP_ID_SECRET_ID="${RIDDIM_WORKFLOW_SYNC_APP_ID_SECRET:-agent-loop/workflow-sync-app-id}"
PRIVATE_KEY_SECRET_ID="${RIDDIM_WORKFLOW_SYNC_PRIVATE_KEY_SECRET:-agent-loop/workflow-sync-private-key}"
EXPECTED_BOT_LOGIN="${RIDDIM_WORKFLOW_SYNC_LOGIN:-riddim-release[bot]}"

require_cmd git
require_cmd aws
require_cmd curl
require_cmd jq
require_cmd openssl

git rev-parse --show-toplevel >/dev/null 2>&1 || die "must run inside a git repository"

infer_repo_from_origin() {
  local remote_url repo
  remote_url="$(git config --get remote.origin.url || true)"
  [[ -n "$remote_url" ]] || die "origin remote not configured; pass --repo OWNER/REPO"
  case "$remote_url" in
    git@github.com:*.git) repo="${remote_url#git@github.com:}"; repo="${repo%.git}" ;;
    https://github.com/*.git) repo="${remote_url#https://github.com/}"; repo="${repo%.git}" ;;
    https://github.com/*) repo="${remote_url#https://github.com/}" ;;
    *) die "unsupported origin remote URL: $remote_url" ;;
  esac
  printf '%s' "$repo"
}

TARGET_REPO="${TARGET_REPO:-$(infer_repo_from_origin)}"
[[ "$TARGET_REPO" == */* ]] || die "--repo must be OWNER/REPO"
TARGET_OWNER="${TARGET_REPO%%/*}"
TARGET_NAME="${TARGET_REPO#*/}"

ORIGIN_REPO="$(infer_repo_from_origin)"
if [[ "$MODE" == "push" ]]; then
  [[ "$ORIGIN_REPO" == "$TARGET_REPO" ]] || die "origin remote repo mismatch: origin=${ORIGIN_REPO}, target=${TARGET_REPO}"
fi

APP_ID="$(aws_get_secret "$APP_ID_SECRET_ID")"
PRIVATE_KEY="$(aws_get_secret "$PRIVATE_KEY_SECRET_ID")"
[[ -n "$APP_ID" ]] || die "${APP_ID_SECRET_ID} is empty"
[[ -n "$PRIVATE_KEY" ]] || die "${PRIVATE_KEY_SECRET_ID} is empty"

NOW="$(date +%s)"
IAT=$(( NOW - 60 ))
EXP=$(( NOW + 540 ))
HEADER_JSON='{"alg":"RS256","typ":"JWT"}'
PAYLOAD_JSON="{\"iat\":${IAT},\"exp\":${EXP},\"iss\":\"${APP_ID}\"}"
HEADER_B64="$(printf '%s' "$HEADER_JSON" | b64url)"
PAYLOAD_B64="$(printf '%s' "$PAYLOAD_JSON" | b64url)"
SIGNING_INPUT="${HEADER_B64}.${PAYLOAD_B64}"

KEY_FILE="$(mktemp)"
printf '%s' "$PRIVATE_KEY" > "$KEY_FILE"
SIG_B64="$(printf '%s' "$SIGNING_INPUT" | openssl dgst -sha256 -sign "$KEY_FILE" | b64url)"
JWT="${SIGNING_INPUT}.${SIG_B64}"
unset PRIVATE_KEY

APP_JSON="$(curl -sf \
  -H "Authorization: Bearer ${JWT}" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/app" \
  2>/dev/null)" || die "failed to fetch GitHub App metadata"

APP_SLUG="$(printf '%s' "$APP_JSON" | jq -r '.slug // empty')"
[[ -n "$APP_SLUG" ]] || die "could not parse GitHub App slug"
ACTUAL_BOT_LOGIN="${APP_SLUG}[bot]"
[[ "$ACTUAL_BOT_LOGIN" == "$EXPECTED_BOT_LOGIN" ]] || die "workflow-sync bot login mismatch: expected ${EXPECTED_BOT_LOGIN}, got ${ACTUAL_BOT_LOGIN}"

INSTALL_JSON="$(curl -sf \
  -H "Authorization: Bearer ${JWT}" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/repos/${TARGET_OWNER}/${TARGET_NAME}/installation" \
  2>/dev/null)" || die "failed to fetch installation for ${TARGET_REPO} (is the app installed on this repo?)"

INSTALL_ID="$(printf '%s' "$INSTALL_JSON" | jq -r '.id // empty')"
INSTALL_SELECTION="$(printf '%s' "$INSTALL_JSON" | jq -r '.repository_selection // empty')"
INSTALL_CONTENTS_PERMISSION="$(printf '%s' "$INSTALL_JSON" | jq -r '.permissions.contents // empty')"
INSTALL_WORKFLOWS_PERMISSION="$(printf '%s' "$INSTALL_JSON" | jq -r '.permissions.workflows // empty')"
[[ -n "$INSTALL_ID" ]] || die "could not parse installation id for ${TARGET_REPO}"
[[ "$INSTALL_CONTENTS_PERMISSION" == "write" ]] || die "workflow-sync app must have contents: write on ${TARGET_REPO}; current permission is ${INSTALL_CONTENTS_PERMISSION:-missing}"
[[ "$INSTALL_WORKFLOWS_PERMISSION" == "write" ]] || die "workflow-sync app must have workflows: write on ${TARGET_REPO}; current permission is ${INSTALL_WORKFLOWS_PERMISSION:-missing}"

TOKEN_JSON="$(curl -sf \
  -X POST \
  -H "Authorization: Bearer ${JWT}" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/app/installations/${INSTALL_ID}/access_tokens" \
  2>/dev/null)" || die "failed to mint installation token"
unset JWT

INSTALL_TOKEN="$(printf '%s' "$TOKEN_JSON" | jq -r '.token // empty')"
[[ -n "$INSTALL_TOKEN" ]] || die "could not parse installation token"

print_status() {
  cat <<EOF
github.com
  ✓ workflow-sync push helper ready for ${ACTUAL_BOT_LOGIN}
  - Bot opt-in: RIDDIM_WORKFLOW_SYNC_PUSH=1
  - AWS profile: ${AWS_PROFILE}
  - AWS region: ${AWS_REGION}
  - Working repo: ${ORIGIN_REPO}
  - Target repo: ${TARGET_REPO}
  - Installation: ${INSTALL_ID}
  - Repository selection: ${INSTALL_SELECTION:-unknown}
  - Permissions: contents=${INSTALL_CONTENTS_PERMISSION:-missing}, workflows=${INSTALL_WORKFLOWS_PERMISSION:-missing}
  - Base ref: ${BASE_REF}
  - Allowed prefix: ${ALLOW_PREFIX}
EOF
}

if [[ "$MODE" == "status" ]]; then
  print_status
  exit 0
fi

git update-index -q --refresh
if [[ -n "$(git status --porcelain)" ]]; then
  die "working tree must be clean; commit the generated workflow changes before direct push"
fi

git rev-parse --verify "$BASE_REF" >/dev/null 2>&1 || die "base ref not found: $BASE_REF"

CHANGED_FILES=()
while IFS= read -r path; do
  [[ -n "$path" ]] && CHANGED_FILES+=("$path")
done < <(git diff --name-only --diff-filter=ACMRT "${BASE_REF}...HEAD")
[[ "${#CHANGED_FILES[@]}" -gt 0 ]] || die "no changed files relative to ${BASE_REF}"

DISALLOWED=()
for path in "${CHANGED_FILES[@]}"; do
  [[ "$path" == "$ALLOW_PREFIX"* ]] || DISALLOWED+=("$path")
done

if [[ "${#DISALLOWED[@]}" -gt 0 ]]; then
  {
    echo "refusing direct push because these paths are outside the allowlist:"
    for path in "${DISALLOWED[@]}"; do
      echo "  - $path"
    done
    echo "allowed prefix: ${ALLOW_PREFIX}"
    echo "safety note: path restriction is enforced here by the sync helper, not by a broad human bypass"
  } >&2
  exit 1
fi

if [[ "$DRY_RUN" == "true" ]]; then
  print_status
  printf '  - Changed files:%s\n' ""
  for path in "${CHANGED_FILES[@]}"; do
    printf '    - %s\n' "$path"
  done
  echo "  - Dry run: true"
  exit 0
fi

ASKPASS_FILE="$(mktemp)"
cat > "$ASKPASS_FILE" <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "x-access-token" ;;
  *Password*) printf '%s\n' "$RIDDIM_WORKFLOW_SYNC_TOKEN" ;;
  *) exit 1 ;;
esac
EOF
chmod 700 "$ASKPASS_FILE"

GIT_TERMINAL_PROMPT=0 \
GIT_ASKPASS="$ASKPASS_FILE" \
RIDDIM_WORKFLOW_SYNC_TOKEN="$INSTALL_TOKEN" \
git push "https://github.com/${TARGET_REPO}.git" "HEAD:refs/heads/${TARGET_BRANCH}"

echo "workflow-sync direct push succeeded for ${TARGET_REPO} (${TARGET_BRANCH})"
