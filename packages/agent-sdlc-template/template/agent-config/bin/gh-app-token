#!/bin/bash
# gh-app-token — narrow GitHub App installation token helper for Symphony.

set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR_TMP="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR_TMP/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# shellcheck source=bin/gh-core.sh
source "${SCRIPT_DIR}/gh-core.sh"

KEY_FILE=""

cleanup_key_file() {
  if [[ -n "${KEY_FILE:-}" ]]; then
    rm -f "$KEY_FILE"
    KEY_FILE=""
  fi
}
trap cleanup_key_file EXIT

die() {
  echo "agent-config/bin/gh-app-token: error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  gh-app-token --identity developer
  gh-app-token --identity reviewer

Options:
  --identity developer|reviewer   Required bot identity
  --help                          Show this help text

Environment:
  AWS_PROFILE                     Default: your-aws-profile
  RIDDIM_DEV_BOT_LOGIN           Override expected developer login
  RIDDIM_REVIEWER_BOT_LOGIN      Override expected reviewer login

Output:
  JSON on stdout with bot_login, app_slug, installation_id, expires_at, and token.
  Diagnostics are printed to stderr.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

verify_bot_dependencies() {
  require_cmd aws
  require_cmd curl
  require_cmd jq
  require_cmd openssl
}

Port_SecretStore_GetSecret() {
  local parameter_name="$1"
  local profile="$2"
  local value
  # AWS SSM Parameter Store requires hierarchical names to start with /.
  # Callers may still pass the SM-style "agent-loop/..." form; normalize.
  case "$parameter_name" in
    /*) ;;
    *) parameter_name="/$parameter_name" ;;
  esac
  value=$(aws ssm get-parameter \
    --name "$parameter_name" \
    --with-decryption \
    --region us-east-1 \
    --profile "$profile" \
    --query 'Parameter.Value' \
    --output text 2>/dev/null) || return 1
  printf '%s' "$value"
}

Port_Clock_Now() {
  date +%s
}

Port_Base64UrlEncode() {
  printf '%s' "$1" | openssl base64 -A | tr '+/' '-_' | tr -d '='
}

Port_JwtSigner_Sign() {
  local header_b64="$1"
  local payload_b64="$2"
  local private_key="$3"

  KEY_FILE=$(mktemp)
  printf '%s' "$private_key" > "$KEY_FILE"

  local signing_input="${header_b64}.${payload_b64}"
  local sig
  sig=$(printf '%s' "$signing_input" | openssl dgst -sha256 -sign "$KEY_FILE" | openssl base64 -A | tr '+/' '-_' | tr -d '=')
  rm -f "$KEY_FILE"
  KEY_FILE=""

  printf '%s' "$sig"
}

Port_GitHubAppApi_GetApp() {
  local jwt="$1"
  local json
  json=$(curl -sf \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app" \
    2>/dev/null) || return 1
  printf '%s' "$json" | jq -r '.slug // empty'
}

Port_GitHubAppApi_GetInstallation() {
  local jwt="$1"
  local json
  json=$(curl -sf \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/orgs/YourGithubOrg/installation" \
    2>/dev/null) || return 1
  printf '%s' "$json" | jq -r '.id // empty'
}

Port_GitHubAppApi_MintToken() {
  local jwt="$1"
  local install_id="$2"
  local json
  json=$(curl -sf \
    -X POST \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${install_id}/access_tokens" \
    2>/dev/null) || return 1
  printf '%s' "$json" | jq -r '[(.token // empty), (.expires_at // empty)] | @tsv'
}

IDENTITY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --identity)
      [[ $# -ge 2 ]] || die "--identity requires a value"
      IDENTITY="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$IDENTITY" ]] || die "--identity is required (developer or reviewer)"

SECRET_PREFIX=""
EXPECTED_LOGIN=""
case "$IDENTITY" in
  developer)
    SECRET_PREFIX="agent-loop/dev-bot"
    EXPECTED_LOGIN="${RIDDIM_DEV_BOT_LOGIN:-riddim-developer-bot[bot]}"
    ;;
  reviewer)
    SECRET_PREFIX="agent-loop/reviewer-bot"
    EXPECTED_LOGIN="${RIDDIM_REVIEWER_BOT_LOGIN:-riddim-reviewer-bot[bot]}"
    ;;
  *)
    die "unsupported identity: ${IDENTITY} (expected developer or reviewer)"
    ;;
esac

verify_bot_dependencies

AWS_PROFILE="${AWS_PROFILE:-your-aws-profile}"
export AWS_PROFILE

if ! MintGitHubAppInstallationToken "$SECRET_PREFIX" "$EXPECTED_LOGIN" "$AWS_PROFILE"; then
  die "$GH_MINT_ERROR"
fi

jq -n \
  --arg identity "$IDENTITY" \
  --arg bot_login "$EXPECTED_LOGIN" \
  --arg app_slug "$GH_APP_SLUG" \
  --arg installation_id "$GH_INSTALL_ID" \
  --arg expires_at "$GH_INSTALL_TOKEN_EXPIRES_AT" \
  --arg token "$GH_INSTALL_TOKEN" \
  '{
    identity: $identity,
    bot_login: $bot_login,
    app_slug: $app_slug,
    installation_id: $installation_id,
    expires_at: $expires_at,
    token: $token
  }'
