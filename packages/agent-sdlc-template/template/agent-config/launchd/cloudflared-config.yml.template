# Cloudflare Tunnel config template — rendered by scripts/install-cloudflared-tunnel.sh
# Installed to ~/.cloudflared/config.yml on the symphonyd host.
# Do NOT commit the rendered file; it contains your tunnel name which ties to
# the credentials JSON in ~/.cloudflared/.

tunnel: TUNNEL_NAME_PLACEHOLDER

# credentials-file is auto-discovered from ~/.cloudflared/<tunnel-id>.json
# when not explicitly set; leave it unset here so the template stays portable
# across different credential file paths.

ingress:
  - hostname: symphony-webhooks.riddim.dev
    service: http://localhost:4779
  # Catch-all rule required by cloudflared — returns 404 for unmatched hostnames.
  - service: http_status:404
